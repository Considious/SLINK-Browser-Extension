{
  "manifest_version": 3,
  "name": "SLINK",
  "version": "0.18.0",
  "description": "Shared Live Intelligence NetworK with Combat and Efficiency reminder tools for Torn.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.torn.com/*",
    "https://api.torn.com/*",
    "https://ffscouter.com/*",
    "https://weav3r.dev/*",
    "https://slinkyleveling.richard-johnson554.workers.dev/*",
    "https://slinkcontributionworker.richard-johnson554.workers.dev/*",
    "https://slinkwarworker.richard-johnson554.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "SLINK",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.torn.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/core/runtime.js",
        "src/core/format.js",
        "src/core/storage.js",
        "src/core/permissions.js",
        "src/core/adhd.js",
        "src/core/market.js",
        "src/core/merits.js",
        "src/core/themes.js",
        "src/core/messaging.js",
        "src/core/modules.js",
        "src/core/war.js",
        "src/content/ui-shell.js",
        "src/modules/leveling.js",
        "src/modules/war.js",
        "src/modules/player-stats.js",
        "src/modules/adhd.js",
        "src/modules/market.js",
        "src/modules/merits.js",
        "src/modules/contribution.js",
        "src/content/content-script.js"
      ]
    }
  ]
}


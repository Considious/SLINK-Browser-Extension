{
  "manifest_version": 3,
  "name": "SLINK — QoL feature preview",
  "version": "0.19.82",
  "description": "Shared Live Intelligence NetworK with Combat, Efficiency, and Quality of Life tools for Torn.",
  "permissions": [
    "alarms",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://api.giphy.com/*",
    "https://chatsticker.com/*",
    "https://www.torn.com/*",
    "https://api.torn.com/*",
    "https://ffscouter.com/*",
    "https://weav3r.dev/*",
    "https://slinkyleveling.richard-johnson554.workers.dev/*",
    "https://slinkcontributionworker.richard-johnson554.workers.dev/*",
    "https://slink-chat-central-test.richard-johnson554.workers.dev/*",
    "https://slink-faction-node-46978-test.richard-johnson554.workers.dev/*",
    "https://slinkwarworker.richard-johnson554.workers.dev/*",
    "https://slinkmuggingworker.richard-johnson554.workers.dev/*",
    "https://yata.yt/*",
    "https://prombot.co.uk:8443/*",
    "https://torn-intel.com/*",
    "https://droqsdb.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "SLINK",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [

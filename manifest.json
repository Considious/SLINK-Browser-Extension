{
  "manifest_version": 3,
  "name": "SLINK",
  "version": "0.19.19",
  "version_name": "0.19.19",
  "description": "Shared Live Intelligence NetworK with Combat, Efficiency, and Quality of Life tools for Torn.",
  "permissions": [
    "alarms",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://api.giphy.com/*",
    "https://chatsticker.com/*",
    "https://www.torn.com/*",
    "https://api.torn.com/*",
    "https://ffscouter.com/*",
    "https://weav3r.dev/*",
    "https://slinkyleveling.richard-johnson554.workers.dev/*",
    "https://slinkcontributionworker.richard-johnson554.workers.dev/*",
    "https://slinkwarworker.richard-johnson554.workers.dev/*",
    "https://slinkmuggingworker.richard-johnson554.workers.dev/*",
    "https://yata.yt/*",
    "https://prombot.co.uk:8443/*",
    "https://torn-intel.com/*",
    "https://droqsdb.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "SLINK",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/themes/halloween-2026-background.png",
        "assets/themes/halloween-2026-icons.png",
        "assets/themes/halloween-2026-brand.png",
        "assets/themes/halloween-2026-chat.png",
        "assets/themes/gothic-valentines-background.png",
        "assets/themes/gothic-valentines-frame.png",
        "assets/themes/gothic-valentines-rose-icon.png",
        "assets/themes/gothic-valentines-rose-corner.png",
        "assets/themes/gothic-valentines-badge-ivory.svg",
        "assets/themes/gothic-valentines-panel-smoke.png",
        "assets/themes/gothic-valentines-panel-damask.png",
        "assets/themes/gothic-valentines-panel-crimson.png",
        "assets/themes/gothic-valentines-divider-left.png",
        "assets/themes/gothic-valentines-divider-middle.png",
        "assets/themes/gothic-valentines-divider-right.png",
        "assets/themes/gothic-valentines-roses-100.png",
        "assets/themes/gothic-valentines-roses-075.png",
        "assets/themes/gothic-valentines-roses-050.png",
        "assets/themes/gothic-valentines-roses-025.png",
        "assets/themes/gothic-valentines-roses-004.png",
        "assets/themes/gothic-valentines-blood-100.png",
        "assets/themes/gothic-valentines-blood-075.png",
        "assets/themes/gothic-valentines-blood-050.png",
        "assets/themes/gothic-valentines-blood-025.png",
        "assets/themes/gothic-valentines-blood-004.png"
      ],
      "matches": [
        "https://www.torn.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.torn.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/core/runtime.js",
        "src/core/format.js",
        "src/core/errors.js",
        "src/core/mugging-ff.js",
        "src/core/clipboard.js",
        "src/core/ui-state.js",
        "src/core/form-state.js",
        "src/core/storage.js",
        "src/core/permissions.js",
        "src/core/player-intelligence.js",
        "src/core/target-list.js",
        "src/core/adhd.js",
        "src/core/market.js",
        "src/core/merits.js",
        "src/core/themes.js",
        "src/core/messaging.js",
        "src/core/page-activity.js",
        "src/core/torn-theme-variables.js",
        "src/core/torn-theme-pages.js",
        "src/core/torn-theme.js",
        "src/content/player-intelligence-dom.js",
        "src/core/faction-chat.js",
        "src/core/abroad-stocks.js",
        "src/core/racing.js",
        "src/core/travel-safety.js",
        "src/core/company.js",
        "src/core/museum.js",
        "src/core/money-property.js",
        "src/core/events.js",
        "src/core/faction-officers.js",
        "src/core/modules.js",
        "src/core/war.js",
        "src/core/bounties.js",
        "src/content/xanax-safety.js",
        "src/core/chat-ff.js",
        "src/core/chat-inline-media.js",
        "src/core/chat-giphy.js",
        "src/core/chat-giphy-ui.js",
        "src/content/custom-chat-buttons.js",
        "src/content/chat-ff.js",
        "src/content/ui-shell.js",
        "src/modules/leveling.js",
        "src/modules/bounties.js",
        "src/modules/mugging.js",
        "src/modules/target-list.js",
        "src/modules/war.js",
        "src/modules/player-stats.js",
        "src/modules/adhd.js",
        "src/modules/market.js",
        "src/modules/merits.js",
        "src/modules/dollar-bazaars.js",
        "src/modules/abroad-stocks.js",
        "src/modules/racing.js",
        "src/modules/travel-safety.js",
        "src/modules/company.js",
        "src/modules/museums.js",
        "src/modules/money-property.js",
        "src/modules/events.js",
        "src/modules/chat.js",
        "src/modules/faction-officers.js",
        "src/modules/contribution.js",
        "src/content/content-script.js"
      ]
    }
  ]
}

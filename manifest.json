{
  "manifest_version": 3,
  "name": "SLINK",
  "version": "0.18.82",
  "description": "Shared Live Intelligence NetworK with Combat, Efficiency, and Quality of Life tools for Torn.",
  "permissions": [
    "alarms",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "https://www.torn.com/*",
    "https://api.torn.com/*",
    "https://ffscouter.com/*",
    "https://weav3r.dev/*",
    "https://slinkyleveling.richard-johnson554.workers.dev/*",
    "https://slinkcontributionworker.richard-johnson554.workers.dev/*",
    "https://slinkwarworker.richard-johnson554.workers.dev/*",
    "https://slinkmuggingworker.richard-johnson554.workers.dev/*",
    "https://yata.yt/*",
    "https://prombot.co.uk:8443/*",
    "https://torn-intel.com/*",
    "https://droqsdb.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "SLINK",
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.torn.com/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/core/runtime.js",
        "src/core/format.js",
        "src/core/ui-state.js",
        "src/core/form-state.js",
        "src/core/storage.js",
        "src/core/permissions.js",
        "src/core/player-intelligence.js",
        "src/core/target-list.js",
        "src/core/adhd.js",
        "src/core/market.js",
        "src/core/merits.js",
        "src/core/themes.js",
        "src/core/messaging.js",
        "src/content/player-intelligence-dom.js",
        "src/core/faction-chat.js",
        "src/core/abroad-stocks.js",
        "src/core/racing.js",
        "src/core/travel-safety.js",
        "src/core/company.js",
        "src/core/museum.js",
        "src/core/money-property.js",
        "src/core/events.js",
        "src/core/faction-officers.js",
        "src/core/modules.js",
        "src/core/war.js",
        "src/core/bounties.js",
        "src/content/custom-chat-buttons.js",
        "src/content/ui-shell.js",
        "src/modules/leveling.js",
        "src/modules/bounties.js",
        "src/modules/mugging.js",
        "src/modules/target-list.js",
        "src/modules/war.js",
        "src/modules/player-stats.js",
        "src/modules/adhd.js",
        "src/modules/market.js",
        "src/modules/merits.js",
        "src/modules/dollar-bazaars.js",
        "src/modules/abroad-stocks.js",
        "src/modules/racing.js",
        "src/modules/travel-safety.js",
        "src/modules/company.js",
        "src/modules/museums.js",
        "src/modules/money-property.js",
        "src/modules/events.js",
        "src/modules/chat.js",
        "src/modules/faction-officers.js",
        "src/modules/contribution.js",
        "src/content/content-script.js"
      ]
    }
  ]
}
